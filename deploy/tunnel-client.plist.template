<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Render: sed -e "s#\$HOME#$HOME#g" -e "s#__LABEL_PREFIX__#com.example#g" \
       deploy/tunnel-client.plist.template > ~/.config/tunnel-client/__LABEL_PREFIX__.tunnel-client.dot.plist
     The API key
     is loaded from the 0600 secret.env into the environment, never into argv. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>__LABEL_PREFIX__.tunnel-client.dot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>set -a; source "$HOME/.config/tunnel-client/secret.env"; set +a; exec "$HOME/.local/bin/tunnel-client" run --profile dot --pid.file "$HOME/.config/tunnel-client/dot.pid"</string>
  </array>
  <key>WorkingDirectory</key><string>$HOME</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>$HOME/Library/Logs/tunnel-client/dot.out.log</string>
  <key>StandardErrorPath</key><string>$HOME/Library/Logs/tunnel-client/dot.err.log</string>
</dict>
</plist>
